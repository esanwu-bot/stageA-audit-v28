+# 行格线最小间距（pt）。
+MIN_ROW_GAP_PT = 0.2
+
+
+def _monotonic_lattice(ys: list[float], lo: float, hi: float
+                       ) -> tuple[list[float], bool]:
+    """把行格线夹成严格递增，且**不改变任何行的序号**。
+
+    为什么不排序：排序会重排行，``GridCell.row`` 与 ``cell_words`` 的索引随之
+    失效，等于把证据打乱。这里只把倒序的那条边界向上推到「前一条 + 最小间距」，
+    行数、行序、每个 cell 归属的行全部不变，只有边界几何被微调。
+
+    可行性：最小间距先压到 ``(hi - lo) / (n - 1)`` 以内，最坏情况整条格线等距
+    塞进 ``lo..hi``，不会越出区域底边。
+
+    返回 (格线, 是否发生过夹紧)。未发生夹紧时逐位等于输入 —— 这是「其他样本
+    输出必须一模一样」的前提。
+    """
+    n = len(ys)
+    if n < 2:
+        return list(ys), False
+    gap = min(MIN_ROW_GAP_PT, (hi - lo) / (n - 1))
+    out = [ys[0]]
+    adjusted = False
+    for value in ys[1:]:
+        floor = out[-1] + gap
+        if value < floor:
+            out.append(floor)
+            adjusted = True
+        else:
+            out.append(value)
+    return out, adjusted
+
+
