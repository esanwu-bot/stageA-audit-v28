+    """只分类哨兵：置 1 时**物理切断** Parser 调用路径。
+
+    与 ``_allow_parse()`` 正交，两者组合出的状态是显式的：
+
+    | ALLOW_PARSE | CLASSIFY_ONLY | 行为 |
+    | --- | --- | --- |
+    | 0 | 任意 | 全部入口返回 FROZEN，连 PDF 都不打开 |
+    | 1 | 0 | 正常：分类 → 仅 DATASHEET 才解析 |
+    | 1 | 1 | 只分类：分类结果照常返回，**任何进入 Parser 的尝试都被拦截** |
+
+    三层拦截（任一层生效即可，不依赖调用方自觉）：
+    L1 ``api_process`` 在 ``decision == DATASHEET`` 后直接返回 SAFETY_BLOCKED，不调度 worker；
+    L2 ``_execute_parse`` 入口直接抛 ``SafetyBlocked``，覆盖 /api/parse 与未来新增调用方；
+    L3 ``parse_worker.py`` 进程内自查，即使被单独拉起也拒绝执行 ``parse_pdf()``。
+    """
+    return os.getenv("ICEX_CLASSIFY_ONLY", "0") == "1"
+
+
+class SafetyBlocked(RuntimeError):
+    """CLASSIFY_ONLY 模式下试图进入 Parser：硬失败，绝不静默降级为「已解析」。"""
+
