+    spec.loader.exec_module(mod)
+    table = getattr(mod, "CONDITION_BACKFILL", None)
+    if not isinstance(table, dict):
+        raise SystemExit("FAIL 生成器里没有 CONDITION_BACKFILL 表")
+    if key not in table:
