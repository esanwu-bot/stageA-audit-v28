+    assert I3.has_table_header(txt, []) is False
+    assert I3._table_header_from_borders(FakePage(CASE_E, CASE_E_BORDER)) is True
+    assert prescan_fake(CASE_E, CASE_E_BORDER) == [1], "p106 式续表被误杀"
+
